{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": false
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "angularsdk": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              {
                "glob": "sdk-config.json",
                "input": "./",
                "output": "./"
              },
              {
                "glob": "{auth.html,authDone.js}",
                "input": "./node_modules/@pega/auth/lib/oauth-client/",
                "output": "./"
              },
              {
                "glob": "bootstrap-shell.*",
                "input": "./node_modules/@pega/constellationjs/dist/",
                "output": "./constellation"
              },
              {
                "glob": "bootstrap-shell.*.*",
                "input": "./node_modules/@pega/constellationjs/dist/",
                "output": "./constellation"
              },
              {
                "glob": "lib_asset.json",
                "input": "./node_modules/@pega/constellationjs/dist/",
                "output": "./constellation"
              },
              {
                "glob": "constellation-core.*",
                "input": "./node_modules/@pega/constellationjs/dist/",
                "output": "./constellation/prerequisite"
              },
              {
                "glob": "constellation-core.*.*",
                "input": "./node_modules/@pega/constellationjs/dist/",
                "output": "./constellation/prerequisite"
              },
              {
                "glob": "*.*",
                "input": "./node_modules/@pega/constellationjs/dist/js",
                "output": "./constellation/prerequisite/js"
              },
              {
                "glob": "*.*",
                "input": "./src/assets/",
                "output": "./constellation/assets"
              },
              {
                "glob": "*.*",
                "input": "./src/assets/icons/",
                "output": "./constellation/assets/icons"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/tinymce",
                "output": "./tinymce"
              },
              "src/assets/img"
            ],
            "styles": ["src/styles.scss", "src/app/_samples/mediaco/mediaCoStyles.scss"],
            "scripts": ["./node_modules/tinymce/tinymce.min.js"],
            "allowedCommonJsDependencies": ["lodash.clonedeep", "lodash.debounce", "lodash.get", "downloadjs", "dayjs", "fast-deep-equal", "moment"]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5mb",
                  "maximumError": "7mb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "angularsdk:build:production"
            },
            "development": {
              "buildTarget": "angularsdk:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "angularsdk:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": ["src/styles.scss"],
            "scripts": []
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "angularsdk:build",
            "compodocArgs": ["-d", "./storybook-assets"],
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "angularsdk:build",
            "compodocArgs": ["-d", "."],
            "outputDir": "storybook-static"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
